{\pard\li400\sa80{\f0\fs22 \'95  Month 3: 3 games/week | ~\$2,856/mo games + \$1,340 tournament = ~\$4,196\par}}
{\pard\li400\sa80{\f0\fs22 \'95  Month 6: 9 games/week | ~\$8,568/mo games\par}}
{\pard\li400\sa200{\f0\fs22 \'95  Month 12: 20+ games/week | ~\$19,040+/mo (memberships add on top)\par}}

\pard\sb300\sa100\brdrb\brdrs\brdrw10\brdrsp100 \par

{\pard\sb400\sa160{\f0\fs32\b 14. Risk Factors}\par}
{\pard\sa100{\f0\fs22\b Low tournament turnout:}{\f0\fs22  Pre-sell spots via waitlist; Meta ads 3 weeks prior; referral incentives.\par}}
{\pard\sa100{\f0\fs22\b Referee no-shows:}{\f0\fs22  Maintain backup referee pool; cancellation policy with penalty.\par}}
{\pard\sa100{\f0\fs22\b Field cost increases:}{\f0\fs22  Build relationships with 2\'963 venues per city; lock in rates early.\par}}
{\pard\sa100{\f0\fs22\b Competitor copies model:}{\f0\fs22  First-mover in South Florida; ratings ecosystem takes time to replicate.\par}}
{\pard\sa100{\f0\fs22\b Slow app adoption:}{\f0\fs22  \$16.99 removes hesitation; tournament experience does the selling.\par}}
{\pard\sa200{\f0\fs22\b SMS delivery delays:}{\f0\fs22  Push notifications as primary channel; SMS as supplement.\par}}

