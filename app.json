{
  "expo": {
    "name": "Urban PL",
    "slug": "UrbanPL",
    "scheme": "urbanpl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.urbanpl.app",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Urban PL needs access to your photo library so you can upload a profile photo that will be visible to other players and referees in your games.",
        "NSCameraUsageDescription": "Urban PL needs access to your camera so you can take a profile photo or upload referee identification documents.",
        "NSLocationWhenInUseUsageDescription": "Urban PL uses your location to show nearby games on the map and provide directions to game venues."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "package": "com.urbanpl.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A84C",
          "sounds": []
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.urbanpl.app",
          "enableGooglePay": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "6a6f69d9-82bf-4834-9704-0b3a087502fe"
      }
    }
  }
}
